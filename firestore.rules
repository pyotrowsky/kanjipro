rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each account can access only its own Kanji.pro journal documents.
    match /users/{userId}/journals/{journalId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      allow read: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['format', 'version', 'device_id', 'seed', 'events'])
        && request.resource.data.format == 'wsjj-kanji-pro-device-journal'
        && request.resource.data.version == 1
        && request.resource.data.device_id is string
        && request.resource.data.seed is map
        && request.resource.data.events is list;
      allow delete: if false;
    }
    // Everything not explicitly covered above is private by default.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
